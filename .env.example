# VPBuddy 环境变量模板
# 复制为 .env 或 .hermes/.env 然后填实际值
# 注意: .env 不入 git(.gitignore 已忽略)

# ===== 飞书(Lark)凭证 =====
# 飞书开放平台 → 应用 → 凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DOMAIN=feishu          # feishu / dingtalk / wecom
FEISHU_MODE=websocket         # websocket / http

# ===== VPBuddy 路径(可选,有默认值) =====
# VPBUDDY_DATA_DIR=/home/zsd/vpbuddy/data/meetings
# VPBUDDY_DOCS_DIR=/home/zsd/vpbuddy/docs
# VPBUDDY_POLL_INTERVAL=30

# ===== UI 服务端口 =====
# VPBUDDY_UI_PORT=8765

# ===== 平台 token(企微/钉钉,可选) =====
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=

# ===== GPU 推理(192.168.10.63) =====
# HF_HUB_OFFLINE=1
# PYANNOTE_LOCAL_DIR=/home/zsd/pyannote_models
