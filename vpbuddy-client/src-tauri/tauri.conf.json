{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPBuddy",
  "version": "0.1.0",
  "identifier": "dev.zsd.vpbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VPBuddy",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "webviewInstallMode": {
      "type": "skipRuntimeInstall"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "librsvg2-0"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local meeting intelligence",
    "longDescription": "VPBuddy: capture, transcribe, and synthesize meeting audio locally. Zero cloud, zero leak."
  }
}
