{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VPBuddy 默认权限 (2026-06-25)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:path:default",
    "notification:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
